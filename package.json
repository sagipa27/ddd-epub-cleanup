{
  "name": "ddd-epub-cleanup",
  "version": "1.0.0",
  "description": "Cleans up pdf2htmlEX/PDF book conversions into semantic, EPUB-ready XHTML. Originally built for 'Domain-Driven Design' (Eric Evans); --pdf=<file> runs the same pipeline on any PDF.",
  "main": "cleanup.js",
  "scripts": {
    "clean:chapter5": "node cleanup.js --write --scope=chapter:5 --input=source/book.html --output=cleaned-html --reportDir=reports",
    "clean:all": "node cleanup.js --write --scope=all --input=source/book.html --output=cleaned-html --reportDir=reports",
    "clean:pdf": "node cleanup.js --write --scope=all --output=cleaned-html --reportDir=reports",
    "process:pdfs": "node batchPdf.js --dir=pdfs --output=epubs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "an-array-of-english-words": "^2.0.0",
    "cheerio": "^1.2.0",
    "iconv-lite": "^0.7.3",
    "pdfjs-dist": "^6.1.200",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1"
  }
}
